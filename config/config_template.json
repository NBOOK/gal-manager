{
    "gamesMainPath": "/home/deck/Games/Gal",
    "gamesDataPath": "/run/media/deck/Data/Games/Gal",
    "gamesSDPath": "/run/media/deck/SDCard/Games/Gal",
    "gamesUSBPath": "/run/media/deck/USB/Games/Gal",
    "gamesNetPath": "/run/media/deck/NetDisk/Games/Gal",
    "gamesAssetsPath": "/home/deck/Pictures/GalArtAssets",
    "gamesExternalPath": "/home/deck/Games/External/Gal",
    "assetsFolderName": "_CustomLibraryAssets",
    "assetsCapsuleName": "_capsule",
    "assetsHeaderName": "_header",
    "assetsHeroName": "_hero",
    "assetsLogoName": "_logo",
    "assetsIconName": "_icon",
    "assetsLowResSuffix": "_sd",
    "assetsLowResFormat": "jpg",
    "assetsLinkLowRes": true,
    "steam": {
        "id": "<STEAM_ID>",
        "shortcutPath": "/home/deck/.steam/steam/userdata/<STEAM_ID>/config/shortcuts.vdf",
        "localConfigPath": "/home/deck/.steam/steam/userdata/<STEAM_ID>/config/localconfig.vdf",
        "gridPath": "/home/deck/.steam/steam/userdata/<STEAM_ID>/config/grid",
        "onlineCategoryPath": "/home/deck/.steam/steam/userdata/<STEAM_ID>/config/cloudstorage/cloud-storage-namespace-1.json",
        "controllerTemplatePath": "/home/deck/.steam/steam/controller_base/templates",
        "controllerConfigPath": "/home/deck/.steam/steam/steamapps/common/Steam Controller Configs/<STEAM_ID>/config"
    },
    "lutris": {
        "steamTargetPath": "/usr/bin/flatpak",
        "steamStartIn": "/usr/bin",
        "steamLaunchOptions": "run net.lutris.Lutris lutris:rungame/",
        "defaultWineRunner": "default",
        "defaultWinePrefix": "wine-tkg-valve-[ds-lav-wmp9]",
        "gameConfigPath": "/home/deck/.var/app/net.lutris.Lutris/config/lutris/games",
        "gameListPath": "/home/deck/.var/app/net.lutris.Lutris/cache/lutris/game-paths.json",
        "dbPath": "/home/deck/.var/app/net.lutris.Lutris/data/lutris/pga.db",
        "iconPath": "/home/deck/.var/app/net.lutris.Lutris/data/icons/hicolor/128x128/apps",
        "bannerPath": "/home/deck/.var/app/net.lutris.Lutris/cache/lutris/banners",
        "coverPath": "/home/deck/.var/app/net.lutris.Lutris/cache/lutris/coverart"
    },
    "heroic": {
        "steamTargetPath": "/home/deck/Applications/Heroic.AppImage",
        "steamStartIn": "/home/deck",
        "steamLaunchOptions": "--no-gui --no-sandbox heroic://launch?appName=",
        "defaultWineRunner": "default",
        "defaultWinePrefix": "default",
        "gameConfigPath": "/home/deck/.config/heroic/GamesConfig",
        "gameListPath": "/home/deck/.config/heroic/sideload_apps/library.json",
        "configPath": "/home/deck/.config/heroic/store/config.json"
    },
    "defaultLocale": "ja_JP.utf8",
    "wineRunnerPath": "/home/deck/Games/Compatibility/runner",
    "winePrefixPath": "/home/deck/Games/Compatibility/prefix"
}