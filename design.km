                                    "resource": [
                                        "Obj"
                                    ],
                                    "note": "```\nif GamePath.Local != NULL:\n\tif GamePath.Local == GamePath.SDCard:\n    \tMove to GamePath.Data\n        Update GamePath.Local\n        Points GamePath.Main to new Local\n \telse:\n    \tMove to GamePath.SDCard\n        Update GamePath.Local\n     \tPoints GamePath.Main to new Local\n```",
                                    "expandState": "expand"
                                },
